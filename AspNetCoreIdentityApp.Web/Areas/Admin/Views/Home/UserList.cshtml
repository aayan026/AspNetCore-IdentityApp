@using AspNetCoreIdentityApp.Web.Areas.Admin.Models
@model List<UserViewModel>
<h2>Üye listesi</h2>
<table class="table table-striped">
	<thead>
		<tr>
			<th>Id</th>
			<th>Kullanici adi</th>
			<th>Email</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.UserId</td>
				<td>@item.UserName</td>
				<td>@item.Email</td>
			</tr>
		}
	</tbody>
</table>